<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".P9Application"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Nine"
        android:allowBackup="true">

        <!-- P9's only launcher entry (decision 5, docs/p9-plan.md): the dialer. Its own
             taskAffinity mirrors why C9's two launcher entries and P9's own future CallActivity
             each get one — nothing else shares it yet, but M4's InCallService/role setup and the
             ACTION_DIAL intent filters land here without disturbing this. -->
        <activity
            android:name=".dial.DialerActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="life.furrer.p9.dial"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

    </application>
</manifest>
