<?xml version="1.0" encoding="utf-8"?>
<!-- A handset: a dim gray capsule with two rounded "earpiece"/"mouthpiece" bulbs at its ends,
     rotated 45 degrees to the classic diagonal receiver angle, with one bright white dot at its
     center — the family's one-bright-element-among-dim-ones motif (see L9's nine-key icon and
     C9's calendar/contacts icons) read here as "a call is connected". Every point of the group
     stays within 30 of the icon's center before rotation, which is preserved by rotation, so the
     whole shape stays inside the adaptive icon's 66dp safe zone (24-84 of the 108x108 viewport)
     after the rotate. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45">
        <path
            android:fillColor="#8A8A8A"
            android:pathData="M46,34 h16 a8,8 0 0 1 8,8 v24 a8,8 0 0 1 -8,8 h-16 a8,8 0 0 1 -8,-8 v-24 a8,8 0 0 1 8,-8 z" />
        <path
            android:fillColor="#8A8A8A"
            android:pathData="M54,34 m-10,0 a10,10 0 1 0 20,0 a10,10 0 1 0 -20,0" />
        <path
            android:fillColor="#8A8A8A"
            android:pathData="M54,74 m-10,0 a10,10 0 1 0 20,0 a10,10 0 1 0 -20,0" />
    </group>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-5,0 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0" />
</vector>
