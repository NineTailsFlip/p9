<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- required="false": P9 still installs (if uselessly) on a telephony-less device, rather
         than the Play/F-Droid store filtering it out entirely. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".P9Application"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Nine"
        android:allowBackup="true">

        <!-- P9's only launcher entry (decision 5, docs/p9-plan.md): the dialer. The DIAL intent
             filters are what make P9 eligible for RoleManager.ROLE_DIALER at all — the role is
             only offered to an app with both an ACTION_DIAL activity and an InCallService. -->
        <activity
            android:name=".dial.DialerActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="life.furrer.p9.dial"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".history.CallDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <!-- Its own taskAffinity for the same reason the dialer activity has one: returning to
             an in-progress call via the ongoing notification must never resurface the dialer
             instead. showWhenLocked/turnScreenOn are set at runtime in onCreate (the modern
             replacement for the deprecated window-flag/manifest-attribute pair). -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="life.furrer.p9.call"
            android:theme="@style/Theme.Nine" />

        <!-- IN_CALL_SERVICE_RINGING=false leaves the ringtone to Telecom; P9 only draws the
             screen. Bound by Telecom only while P9 holds ROLE_DIALER.

             tools:ignore="ForegroundServicePermission": lint wants MANAGE_OWN_CALLS alongside
             FOREGROUND_SERVICE_PHONE_CALL, but that permission is for self-managed
             ConnectionService apps (their own VoIP calls outside Telecom's system dialer role)
             — an InCallService like this one is trusted by Telecom directly once bound, with no
             extra permission to declare or request. -->
        <service
            android:name=".call.P9InCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:foregroundServiceType="phoneCall"
            tools:ignore="ForegroundServicePermission">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_RINGING" android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- The ongoing-call notification's hang-up action. -->
        <receiver android:name=".call.DisconnectCallReceiver" android:exported="false" />

    </application>
</manifest>
